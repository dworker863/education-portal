datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id                    String                 @id @default(cuid())
  name                  String?
  email                 String                 @unique
  password              String?
  emailVerified         DateTime?
  image                 String?
  role                  UserRole               @default(USER)
  firstName             String?
  lastName              String?
  birthDate             DateTime?
  rating                Int                    @default(0)
  rank                  String                 @default("D-")
  moneyUSD              Int                    @default(0)
  meta                  Json                   @default("{}")
  accounts              Account[]
  coursesInProgress     Course[]               @relation("UsersInProgressCourses")
  completedCourses      Course[]               @relation("UsersCompletedCourses")
  completedExercises    Exercise[]
  TwoFactorConfirmation TwoFactorConfirmation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model ResetPasswordToken {
  id      String   @id @default(cuid())
  email   String
  token   String
  expires DateTime
}

model TwoFactorToken {
  id      String   @id @default(cuid())
  email   String
  token   String
  expires DateTime
}

model TwoFactorConfirmation {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id              String       @id @default(cuid())
  name            String
  description     String
  icon            String
  priceUSD        Float
  certificateId   String?
  category        String
  meta            Json         @default("{}")
  lessons         Lesson[]
  usersInProgress User[]       @relation("UsersInProgressCourses")
  completedUsers  User[]       @relation("UsersCompletedCourses")
  Achievements    Achievement?
}

model Lesson {
  id       String    @id @default(cuid())
  name     String
  content  String
  images   String[]  @default([])
  video    String?
  meta     Json      @default("{}")
  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String
  exercise Exercise?
}

model Exercise {
  id             String  @id @default(cuid())
  name           String
  task           String
  code           String?
  test           String
  solution       String
  language       String  @default("JavaScript")
  requiredRank   String  @default("D-")
  prizePoints    Int
  meta           Json    @default("{}")
  lesson         Lesson? @relation(fields: [lessonId], references: [id])
  lessonId       String? @unique
  completedUsers User[]
}

model Achievement {
  id           String @id @default(cuid())
  name         String
  task         String
  icon         String
  language     String @default("JavaScript")
  requiredRank String @default("D-")
  discount     Int
  meta         Json   @default("{}")
  course       Course @relation(fields: [courseId], references: [id])
  courseId     String @unique
}
