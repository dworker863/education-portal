generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                    @id @default(cuid())
  name                  String?
  email                 String                    @unique
  password              String?
  emailVerified         DateTime?
  image                 String?
  firstName             String?
  lastName              String?
  birthDate             DateTime?
  rating                Int                       @default(0)
  rank                  String                    @default("D-")
  moneyUSD              Float                     @default(0)
  subscription          Json?
  meta                  Json                      @default("{}")
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  role                  UserRole                  @default(USER)
  accounts              Account[]
  TwoFactorConfirmation TwoFactorConfirmation?
  achievementsProgress  UserAchievementProgress[]
  coursesProgress       UserCourseProgress[]
  discounts             Discount[]                @relation("DiscountToUser")
  completedExercises    Exercise[]                @relation("ExerciseToUser")
  completedTests        Test[]                    @relation("TestToUser")

  @@index([rating])
  @@index([name])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model ResetPasswordToken {
  id      String   @id @default(cuid())
  email   String
  token   String
  expires DateTime
}

model TwoFactorToken {
  id      String   @id @default(cuid())
  email   String
  token   String
  expires DateTime
}

model TwoFactorConfirmation {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Course {
  id            String               @id @default(cuid())
  name          String               @unique
  description   String
  icon          String
  priceUSD      Float
  certificateId String?
  category      String
  meta          Json                 @default("{}")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  usersProgress UserCourseProgress[]
  lessons       Lesson[]
  discounts     Discount[]           @relation("CourseToDiscount")

  @@index([name])
}

model UserCourseProgress {
  id               String    @id @default(cuid())
  progress         Float     @default(0)
  lastAccessedAt   DateTime  @default(now())
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  meta             Json      @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User      @relation(fields: [userId], references: [id])
  userId           String
  course           Course    @relation(fields: [courseId], references: [id])
  courseId         String
  currentLesson    Lesson    @relation(fields: [currentLessonId], references: [id])
  currentLessonId  String    @unique
  completedLessons Lesson[]  @relation("CompletedLessons")

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([progress])
  @@index([completedAt])
}

model Lesson {
  id                String               @id @default(cuid())
  name              String
  content           String
  images            String[]             @default([])
  video             String?
  meta              Json                 @default("{}")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  course            Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId          String
  exercises         Exercise[]
  tests             Test[]
  currentInProgress UserCourseProgress?
  completedByUsers  UserCourseProgress[] @relation("CompletedLessons")

  @@unique([name, courseId])
  @@index([name])
  @@index([courseId])
}

model Exercise {
  id               String   @id @default(cuid())
  name             String
  task             String
  code             String?
  test             String
  solution         String
  language         String   @default("JavaScript")
  requiredRank     String   @default("D-")
  prizePoints      Int
  meta             Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  lesson           Lesson?  @relation(fields: [lessonId], references: [id])
  lessonId         String?
  completedByUsers User[]   @relation("ExerciseToUser")

  @@unique([name, language])
  @@index([name])
  @@index([lessonId])
}

model Test {
  id               String   @id @default(cuid())
  name             String
  task             String
  variants         String[]
  solution         String
  language         String   @default("JavaScript")
  requiredRank     String   @default("D-")
  prizePoints      Int
  meta             Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  lesson           Lesson?  @relation(fields: [lessonId], references: [id])
  lessonId         String?
  completedByUsers User[]   @relation("TestToUser")

  @@unique([name, lessonId])
  @@index([name])
  @@index([lessonId])
}

model Achievement {
  id            String                    @id @default(cuid())
  name          String                    @unique
  icon          String
  description   String
  criteria      Json
  criteriaType  String
  reward        Json
  startDate     DateTime
  endDate       DateTime?
  meta          Json                      @default("{}")
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  usersProgress UserAchievementProgress[]

  @@index([name])
  @@index([criteriaType])
}

model UserAchievementProgress {
  id             String      @id @default(cuid())
  progress       Float       @default(0)
  stepsCompleted Json        @default("{}")
  startedAt      DateTime    @default(now())
  completedAt    DateTime?
  meta           Json        @default("{}")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  user           User        @relation(fields: [userId], references: [id])
  userId         String
  achievement    Achievement @relation(fields: [achievementId], references: [id])
  achievementId  String

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
  @@index([progress])
  @@index([completedAt])
}

model Discount {
  id                  String    @id @default(cuid())
  code                String    @unique
  percent             Int
  minAmountToActivate Float     @default(0) //Минимальная сумма заказа, при которой скидка может быть активирована.
  maxAmountToActivate Float     @default(0) //Максимальная сумма заказа, при которой скидка всё ещё применима.
  validFrom           DateTime  @default(now())
  validUntil          DateTime?
  meta                Json      @default("{}")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  courses             Course[]  @relation("CourseToDiscount")
  users               User[]    @relation("DiscountToUser")

  @@index([percent])
  @@index([validUntil])
}

enum UserRole {
  ADMIN
  USER
}
